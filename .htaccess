RewriteEngine On
Options -Indexes -MultiViews

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Never expose application internals, migrations or maintenance commands.
RewriteRule ^(?:app|database|scripts)(?:/|$) - [F,L,NC]

# If the request is for an existing file, serve it directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Route everything else through the front-controller
RewriteRule ^(.*)$ index.php [L]
